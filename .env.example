# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Your public site URL (used for SEO: canonical links, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Email (Resend, free plan: 3,000 emails/month, 1,000 contacts) ---
# 1. Sign up at https://resend.com with the email that should RECEIVE messages
# 2. Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered (defaults to the email in data/site.ts).
# Until you verify a domain in Resend, this MUST be the email of your Resend account.
CONTACT_TO_EMAIL=farzeenwasif15@gmail.com

# Sender address. Leave empty to use Resend's test sender (onboarding@resend.dev).
# After verifying your own domain in Resend, set e.g.: Leaflow <hello@yourdomain.com>
RESEND_FROM_EMAIL=

# Optional: Resend segment id to group newsletter subscribers (Audience → Segments)
RESEND_SEGMENT_ID=
